<?xml version="1.0" encoding="UTF-8"?>
<!--
  Stands for TMail's tmail-backend/ folder: the modules TMail CI tests.
  TMail's Test stage runs Maven from this folder, so James modules are outside the reactor there:
  they come as jars from ~/.m2, installed by the Compile stage.
  The build cache is configured in .mvn/ here, so only builds started from this folder use it.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.linagora.tmail.sample</groupId>
        <artifactId>tmail-sample-parent</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>tmail-backend</artifactId>
    <packaging>pom</packaging>

    <modules>
        <module>jmap-extensions</module>
        <module>ai-bot</module>
        <module>distributed-app</module>
        <module>integration-tests</module>
    </modules>

    <properties>
        <!-- Build cache key (G3): the exact JDK, vendor and version, of the build -->
        <build.cache.jdk>${java.vendor} ${java.version}</build.cache.jdk>
        <!-- Build cache key (G16): the Maven flags of the CI Test stage. Properties passed with -D are not in the key; CI repeats
             them here, from the pipeline actually executed (for fork PRs, the target branch's Jenkinsfile) -->
        <build.cache.ci.flags>none</build.cache.ci.flags>
    </properties>

    <build>
        <pluginManagement>
            <plugins>
                <!-- The cache hashes plugin configuration: these values enter every module's key.
                     Tests also see them as system properties, which is harmless -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <configuration>
                        <systemPropertyVariables>
                            <build.cache.jdk>${build.cache.jdk}</build.cache.jdk>
                            <build.cache.ci.flags>${build.cache.ci.flags}</build.cache.ci.flags>
                        </systemPropertyVariables>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
