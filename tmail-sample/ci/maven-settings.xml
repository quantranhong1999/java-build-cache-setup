<?xml version="1.0" encoding="UTF-8"?>
<!-- CI Maven settings: the build cache write credential comes from the environment,
     bound by Jenkins in the master job only. Without it, uploads are rejected (401) and the build only reads. -->
<settings xmlns="http://maven.apache.org/SETTINGS/1.2.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/SETTINGS/1.2.0 https://maven.apache.org/xsd/settings-1.2.0.xsd">
    <servers>
        <server>
            <!-- Matches <remote id="build-cache"> in .mvn/maven-build-cache-config.xml -->
            <id>build-cache</id>
            <username>${env.BUILD_CACHE_USER}</username>
            <password>${env.BUILD_CACHE_PASSWORD}</password>
        </server>
    </servers>
</settings>
