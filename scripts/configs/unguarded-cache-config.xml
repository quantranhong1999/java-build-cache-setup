<?xml version="1.0" encoding="UTF-8"?>
<!--
  Triage only: the extension with its defaults and none of the guards of tmail-sample/.mvn/maven-build-cache-config.xml.
  Used to show that each risk the guards address is real.
-->
<cache xmlns="http://maven.apache.org/BUILD-CACHE-CONFIG/1.4.0"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="http://maven.apache.org/BUILD-CACHE-CONFIG/1.4.0 https://maven.apache.org/xsd/build-cache-config-1.4.0.xsd">
    <configuration>
        <enabled>true</enabled>
        <hashAlgorithm>SHA-256</hashAlgorithm>
        <remote enabled="true" id="build-cache">
            <url>http://localhost:8090/tmail</url>
        </remote>
    </configuration>
</cache>
